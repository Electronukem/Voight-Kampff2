# Normalize line endings: LF in the repository, native in the working copy.
# Keeps Windows and macOS checkouts from fighting over every file.
* text=auto

# Always LF, regardless of platform.
*.sh        text eol=lf
*.py        text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
.gitignore  text eol=lf

# Git hooks have no file extension but are bash scripts. CRLF here breaks
# the shebang, so pin them to LF on every platform including Windows.
.githooks/** text eol=lf
.github/CODEOWNERS text eol=lf

# Always CRLF.
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Binary — never touch, never diff.
*.png       binary
*.jpg       binary
*.mp4       binary
*.pt        binary
*.pth       binary
*.safetensors binary
*.bag       binary
*.mcap      binary
